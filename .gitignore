# Ignore list for Eagle, a PCB layout tool

# Backup files
*.s#?
*.b#?
*.l#?
*.b$?
*.s$?
*.l$?

# Eagle project file
# It contains a serial number and references to the file structure
# on your computer.
# comment the following line if you want to have your project file included.
eagle.epf

# Autorouter files
*.pro
*.job

# CAM files
*.$$$
*.cmp
*.ly2
*.l15
*.sol
*.plc
*.stc
*.sts
*.crc
*.crs

*.dri
*.drl
*.gpi
*.pls
*.ger
*.xln

*.drd
*.drd.*

*.s#*
*.b#*

*.info

*.eps

# file locks introduced since 7.x
*.lck

# BrainFuino backups and KiCad
# Ignore the backups folder created by your workflow
Brainfuino-backups/

# Ignore common KiCad caches, generated files and backups (keep sources)
fp-info-cache
*.kicad_prl
*.kicad_pcb-bak
*-bak
*_bak
*~
*.bak
*.tmp

# OS junk
.DS_Store
Thumbs.db

# MkDocs build outputs
site/
documentation/site/
.cache/

# Local task tracking
DOCS_TODO.md

# Lattice Diamond temporary files and logs
brainfuck_uP-FPGA-softprocessor/**/*.html
brainfuck_uP-FPGA-softprocessor/**/.build_status
brainfuck_uP-FPGA-softprocessor/**/.run_manager.ini
brainfuck_uP-FPGA-softprocessor/**/*_tcr.dir/
brainfuck_uP-FPGA-softprocessor/promote.xml
brainfuck_uP-FPGA-softprocessor/reportview.xml

# STM32 build intermediates (keep .hex)
companion-STM32-firmware/Debug/*.elf
companion-STM32-firmware/Debug/*.map
companion-STM32-firmware/Debug/build/

# Bad Apple media intermediates
scripts/bad_apple/frames/
scripts/bad_apple/*.mp4
